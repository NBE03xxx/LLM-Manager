<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>LLM-Manager contributors</vendor>
  <vendor_url>https://github.com/NBE03xxx/LLM-Manager</vendor_url>
  <action id="io.github.nbe03xxx.llm-manager.apply-system-settings">
    <description>Apply approved LLM-Manager settings on this LOCAL computer</description>
    <message>LOCAL authentication is required to apply approved Ollama system settings on this computer</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/llm-manager-helper</annotate>
  </action>
  <action id="io.github.nbe03xxx.llm-manager.review-system-restore">
    <description>Review an LLM-Manager system backup on this LOCAL computer</description>
    <message>LOCAL authentication is required to inspect and save an Ollama restore review; this does not restore settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/llm-manager-restore-review</annotate>
  </action>
  <action id="io.github.nbe03xxx.llm-manager.execute-system-restore">
    <description>Execute an approved LLM-Manager restore on this LOCAL computer</description>
    <message>LOCAL authentication is required to restore the approved Ollama system settings on this computer</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/llm-manager-restore-execute</annotate>
  </action>
</policyconfig>
